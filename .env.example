# Copy to .env on the Raspberry Pi. Generate a bcrypt hash with:
# docker compose run --rm api python -c "import bcrypt,getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())"
INVERTER_MODE=hardware
ADMIN_PASSWORD_HASH=
INVERTER_POLL_SECONDS=5
INVERTER_USB_VENDOR_ID=0x0665
INVERTER_USB_PRODUCT_ID=0x5161

