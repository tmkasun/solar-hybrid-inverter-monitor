#!/usr/bin/env bash
set -euo pipefail

echo "Host: $(hostname)"
python3 --version
python3 -c 'import sys; assert sys.version_info >= (3, 8), "Python 3.8 or newer is required"'
test -e /dev/bus/usb || { echo "/dev/bus/usb is unavailable."; exit 1; }
if ! command -v gcc >/dev/null || ! command -v pkg-config >/dev/null || ! pkg-config --exists glib-2.0; then
  echo "BLE dependency build tools are missing."
  echo "Install them and run this script again:"
  echo "  sudo apt update && sudo apt install -y python3-venv build-essential pkg-config libglib2.0-dev bluetooth bluez"
  exit 1
fi
if command -v lsusb >/dev/null && lsusb -d 0665:5161 >/dev/null 2>&1; then
  echo "Sako USB device 0665:5161 detected."
else
  echo "WARNING: USB inverter 0665:5161 is not detected."
fi
if command -v bluetoothctl >/dev/null; then
  echo "Bluetooth tooling detected."
else
  echo "WARNING: bluetoothctl is not installed; install BlueZ before enabling JK-BMS polling."
fi
