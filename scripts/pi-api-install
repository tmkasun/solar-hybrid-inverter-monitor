#!/usr/bin/env bash
set -euo pipefail

root_dir=$(cd "$(dirname "$0")/.." && pwd)
service_user=${SUDO_USER:-$USER}
escaped_root=$(printf '%s' "$root_dir" | sed 's/[&/]/\\&/g')
escaped_user=$(printf '%s' "$service_user" | sed 's/[&/]/\\&/g')

command -v python3 >/dev/null || { echo "Python 3 is required."; exit 1; }
"$root_dir/scripts/pi-api-preflight"

show_venv_install_help() {
  echo "Could not create a virtual environment."
  echo "Install Python venv support and run this script again:"
  echo "  sudo apt update && sudo apt install -y python3-venv"
}

if ! python3 -c 'import ensurepip, venv' >/dev/null 2>&1; then
  show_venv_install_help
  exit 1
fi

venv_dir=$root_dir/backend/.venv
venv_python=$venv_dir/bin/python
system_python_version=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')
venv_python_version=""
if [ -x "$venv_python" ]; then
  venv_python_version=$($venv_python -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')
fi

if [ "$venv_python_version" != "$system_python_version" ]; then
  echo "Creating Python $system_python_version virtual environment (previous: ${venv_python_version:-missing})."
  python3 -m venv --clear "$venv_dir" || {
    show_venv_install_help
    exit 1
  }
fi

"$venv_python" -m ensurepip --upgrade || {
  show_venv_install_help
  exit 1
}
"$venv_python" -m pip install --upgrade pip
"$venv_python" -m pip install -r "$root_dir/backend/requirements.txt"

sudo groupadd --system --force sako-inverter
sudo usermod -aG sako-inverter "$service_user"
if getent group bluetooth >/dev/null; then
  sudo usermod -aG bluetooth "$service_user"
fi
sudo install -d -o "$service_user" -g sako-inverter -m 0750 /var/lib/sako-inverter /etc/sako-inverter
if [ ! -e /var/solar.log ]; then
  sudo install -m 0640 -o "$service_user" -g sako-inverter /dev/null /var/solar.log
else
  sudo chown "$service_user":sako-inverter /var/solar.log
  sudo chmod 0640 /var/solar.log
fi
sudo install -m 0644 "$root_dir/deployment/99-sako-inverter.rules" /etc/udev/rules.d/99-sako-inverter.rules
sudo udevadm control --reload-rules
sudo udevadm trigger

if [ ! -f /etc/sako-inverter/api.env ]; then
  sudo install -m 0640 -o root -g sako-inverter "$root_dir/deployment/sako-inverter-api.env.example" /etc/sako-inverter/api.env
  echo "Created /etc/sako-inverter/api.env. Set ADMIN_PASSWORD_HASH before enabling remote settings."
fi
if ! sudo grep -q '^LOG_FILE=' /etc/sako-inverter/api.env; then
  printf '\nLOG_FILE=/var/solar.log\n' | sudo tee -a /etc/sako-inverter/api.env >/dev/null
fi

sed -e "s/@PROJECT_DIR@/$escaped_root/g" -e "s/@SERVICE_USER@/$escaped_user/g" \
  "$root_dir/deployment/sako-inverter-api.service.template" | sudo tee /etc/systemd/system/sako-inverter-api.service >/dev/null
sed -e "s/@SERVICE_USER@/$escaped_user/g" \
  "$root_dir/deployment/sako-inverter-api.logrotate.template" | sudo tee /etc/logrotate.d/sako-inverter-api >/dev/null
sudo systemctl daemon-reload
sudo systemctl enable --now sako-inverter-api.service
sudo systemctl status --no-pager sako-inverter-api.service
echo "API installed. Log out and back in before running the direct CLI as $service_user so its new USB group takes effect."
